{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crimsonwise-2",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
